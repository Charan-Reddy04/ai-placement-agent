PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ai-placement-agent
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
FRONTEND_URL=http://localhost:5173
# For production (Render), set FRONTEND_URL to:
# FRONTEND_URL=https://ai-placement-agent-red.vercel.app
# Groq (OpenAI-compatible Chat Completions API)
# Get a free key at https://console.groq.com/keys
GROK_API_URL=https://api.groq.com/openai/v1
GROK_API_KEY=your_groq_api_key
# Any Groq-hosted chat model works, e.g.:
#   openai/gpt-oss-120b   (recommended, strong JSON adherence)
#   llama-3.3-70b-versatile
GROK_MODEL=openai/gpt-oss-120b

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
